{
  "type": "object",
  "additionalProperties": false,
  "required": ["indicators", "hardThresholds", "shortTermConclusion", "midTermConclusion", "longTermConclusion", "spotlightSignalId", "spotlightTitle", "spotlightReason", "weeklyExtra", "thursdayDeepDive", "dataNotes"],
  "properties": {
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "numValue", "date", "source", "signal", "trend", "interpretation"],
        "properties": {
          "id": { "type": "string" },
          "value": { "type": "string" },
          "numValue": { "type": ["number", "null"] },
          "date": { "type": "string" },
          "source": { "type": "string" },
          "signal": { "type": "string", "enum": ["green", "yellow", "red"] },
          "trend": { "type": "string", "enum": ["up", "down", "same"] },
          "interpretation": { "type": "string" }
        }
      }
    },
    "hardThresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "currentReading", "status", "notes"],
        "properties": {
          "id": { "type": "string" },
          "currentReading": { "type": "string" },
          "status": { "type": "string", "enum": ["no", "warning", "yes"] },
          "notes": { "type": "string" }
        }
      }
    },
    "shortTermConclusion": { "type": "string" },
    "midTermConclusion": { "type": "string" },
    "longTermConclusion": { "type": "string" },
    "spotlightSignalId": { "type": "string" },
    "spotlightTitle": { "type": "string" },
    "spotlightReason": { "type": "string" },
    "weeklyExtra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sp500ForwardPE", "tipsRealYield10Y", "dxy", "goldSp500Ratio", "date"],
      "properties": {
        "sp500ForwardPE": { "type": "string" },
        "tipsRealYield10Y": { "type": "string" },
        "dxy": { "type": "string" },
        "goldSp500Ratio": { "type": "string" },
        "date": { "type": "string" }
      }
    },
    "thursdayDeepDive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m2Growth", "sloosReport", "chicagoFedNfci", "date"],
      "properties": {
        "m2Growth": { "type": "string" },
        "sloosReport": { "type": "string" },
        "chicagoFedNfci": { "type": "string" },
        "date": { "type": "string" }
      }
    },
    "dataNotes": { "type": "array", "items": { "type": "string" } }
  }
